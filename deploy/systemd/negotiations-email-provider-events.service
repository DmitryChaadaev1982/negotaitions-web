[Unit]
Description=NegotAItions email provider-event Data Streams consumer
# Disabled by default. Enable only during a controlled provider-event canary.
After=network-online.target
Wants=network-online.target
# Bounded restart budget: a repeatedly failing consumer stops instead of
# hot-looping against Data Streams or PostgreSQL.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/negotaitions/app
EnvironmentFile=/etc/negotaitions/env.production
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run email:events:consume
Restart=on-failure
RestartSec=10s
# Terminal application exit codes (see lib/email/provider-event-consumer-cli.ts):
#   78 invalid configuration
#   77 authentication / authorization failure
# Neither can be fixed by restarting, so systemd must not retry them.
RestartPreventExitStatus=78 77
# Exit code 0 also covers "ingestion disabled by design" and controlled stops.
# TimeoutStopSec must exceed EMAIL_PROVIDER_EVENT_SHUTDOWN_TIMEOUT_MS (15s
# default) plus an operational margin so the application-level shutdown budget
# is the one that fires first.
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=negotiations-email-provider-events

[Install]
# WantedBy=multi-user.target
# DO NOT enable until Data Streams subscription, dedicated credentials, and
# EMAIL_PROVIDER_EVENT_INGESTION_ENABLED=true are approved for canary.
