[Unit]
Description=Run NegotAItions email delivery worker every minute
# Installed disabled by default. The controlled production canary uses
# negotiations-email-canary@<id>.service, not this normal worker timer.
# After a successful production canary and explicit approval, enable with:
#   systemctl enable --now negotiations-email-worker.timer

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
RandomizedDelaySec=10s
Persistent=true
Unit=negotiations-email-worker.service

[Install]
WantedBy=timers.target
