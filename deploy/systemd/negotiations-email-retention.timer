[Unit]
Description=Run NegotAItions email retention cleanup daily
# Installed disabled by default. Enable only after retention dry-run passes,
# retention windows/configuration are valid, and explicit approval is given:
#   systemctl enable --now negotiations-email-retention.timer

[Timer]
# Run once daily, with a randomised delay to avoid maintenance window collisions.
OnBootSec=30min
OnCalendar=daily
RandomizedDelaySec=1800s
Persistent=true
Unit=negotiations-email-retention.service

[Install]
WantedBy=timers.target
