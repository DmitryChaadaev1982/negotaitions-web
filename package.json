{
  "name": "negotiations-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "prisma db seed",
    "test:unit": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:full": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:local:list": "playwright test --config=playwright.local.config.ts --list",
    "test:e2e:local": "playwright test --config=playwright.local.config.ts",
    "test:e2e:smoke:browser": "playwright test --config=playwright.local.config.ts --project=chromium --grep @browser-smoke",
    "test:stage310": "node --import tsx --test \"lib/session-room-lifecycle.test.ts\" \"lib/session-recording-stop-relay.test.ts\" \"lib/recording-stop-delivery-policy.test.ts\" \"lib/stage-3-10-maintenance.test.ts\" \"lib/voximplant/main-room-scenario.test.ts\" && playwright test --config=playwright.local.config.ts tests/e2e/session-finish-canonical.spec.ts tests/e2e/voximplant-room-presence.spec.ts --project=chromium",
    "test:stage310:browser": "playwright test --config=playwright.local.config.ts --project=chromium tests/e2e/event-completion.spec.ts --grep @browser-smoke",
    "test:e2e:db:check": "tsx scripts/e2e/check-database.ts",
    "test:e2e:tunnel:check": "node scripts/e2e/check-reverse-tunnel.mjs",
    "test:e2e:tunnel:list": "playwright test --list --grep @requires-tunnel",
    "test:e2e:tunnel": "npm run test:e2e:tunnel:check && playwright test --project=chromium --grep @requires-tunnel --grep-invert @live-provider",
    "test:e2e:live:list": "playwright test --list --grep @live-provider",
    "test:e2e:live": "playwright test --project=chromium --grep @live-provider",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run lint && npm run build && npx prisma validate && npm run test:e2e",
    "validate:fast": "npm run lint && npx prisma validate && npx prisma generate && npm run test:unit && npm run test:e2e:list",
    "validate:deploy": "npm run validate:fast && npm run build",
    "smoke:vox-recording": "tsx scripts/smoke-voximplant-recording.ts",
    "vox:scenario:prepare": "node scripts/voximplant-sync-scenario.mjs",
    "vox:scenario:upload": "node scripts/voximplant-upload-scenario.mjs",
    "vox:scenario:upload:direct": "node scripts/voximplant-upload-scenario-direct.mjs",
    "vox:scenario:dry-run": "node scripts/voximplant-upload-scenario.mjs --dry-run",
    "vox:scenario:check": "node scripts/voximplant-check-scenario-drift.mjs",
    "inspect:audio": "tsx scripts/inspect-audio-recording.ts",
    "pause-filter:calibrate": "tsx scripts/pause-filter-calibrate-session.ts",
    "maintenance:stage310": "tsx scripts/ops/stage-3-10-maintenance.ts",
    "poc:vox:run": "tsx scripts/poc/voximplant-server-stop/run-poc.ts",
    "poc:vox:last-report": "tsx scripts/poc/voximplant-server-stop/show-last-report.ts",
    "poc:vox:cleanup": "tsx scripts/poc/voximplant-server-stop/cleanup-poc.ts",
    "poc:vox:start-conference": "tsx scripts/poc/voximplant-server-stop/start-conference.ts",
    "poc:vox:ping": "tsx scripts/poc/voximplant-server-stop/send-control-command.ts --action=ping",
    "poc:vox:stop-recording": "tsx scripts/poc/voximplant-server-stop/send-control-command.ts --action=stop_recording",
    "poc:vox:status": "tsx scripts/poc/voximplant-server-stop/inspect-result.ts",
    "poc:vox:clear-state": "tsx scripts/poc/voximplant-server-stop/inspect-result.ts --clear",
    "poc:vox:test-callback": "tsx scripts/poc/voximplant-server-stop/test-callback.ts",
    "poc:vox:join-plan": "tsx scripts/poc/voximplant-server-stop/join-plan.ts",
    "poc:vox:inspect-run": "tsx scripts/poc/voximplant-server-stop/inspect-run.ts",
    "poc:vox:test-browser-prewarm": "tsx scripts/poc/voximplant-server-stop/test-browser-prewarm.ts",
    "poc:vox:test-participant-access": "tsx scripts/poc/voximplant-server-stop/test-participant-access.ts",
    "poc:vox:test-recording-start": "tsx scripts/poc/voximplant-server-stop/test-recording-start.ts",
    "test:poc:vox-server-stop": "node --import tsx --test \"lib/voximplant/poc/**/*.test.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@voximplant/websdk": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.5",
    "nanoid": "^5.1.14",
    "next": "16.2.9",
    "openai": "^6.44.0",
    "pg": "^8.16.3",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@voximplant/voxengine-ci": "^34.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
