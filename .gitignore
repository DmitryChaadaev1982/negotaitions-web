# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

.env.local

tmp/
.debug/
playwright-report/
test-results/
coverage/
.agent/preflight.json
.agent/validation-baseline.json

# Archive/output artifacts
*.zip
*.tar
*.tar.gz
*.tgz
*.bak
*.old

# VoxEngine CI — generated upload staging folder (set via VOX_CI_ROOT_PATH)
voxengine-ci/
.voxengine-ci/

# Voximplant service account credentials (never commit)
# VOX_CI_CREDENTIALS points to one of these files
*voximplant*service-account*.json
*voximplant*credentials*.json
*-private.json

# Local scenario sync state (non-sensitive, but machine-specific)
.vox-scenario-build-id
