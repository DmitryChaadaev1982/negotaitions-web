# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

.env.local

tmp/
.debug/
playwright-report/
test-results/
artifacts/
coverage/
.agent/preflight.json
.agent/validation-baseline.json
.agent/validation.lock
.agent/prisma-generate.lock
.agent/stage-3-24a-vox-orphan-cleanup-dry-run-*

# Archive/output artifacts
*.zip
*.tar
*.tar.gz
*.tgz
*.bak
*.old
/artifacts/stage-3-12b-observer-scaling/

# VoxEngine CI — generated upload staging folder (set via VOX_CI_ROOT_PATH)
voxengine-ci/
.voxengine-ci/

# Voximplant service account credentials (never commit)
# VOX_CI_CREDENTIALS points to one of these files
*voximplant*service-account*.json
*voximplant*credentials*.json
*-private.json

# Local scenario sync state (non-sensitive, but machine-specific)
.vox-scenario-build-id

# EO machine/runtime artifacts. The repository profile is versioned Product metadata.
.eo/*
!.eo/repository-profile.json

# Version-controlled Cursor task-routing configuration. Keep unrelated local
# Cursor state excluded while allowing shared agents, rules, and Skills.
.cursor/*
!.cursor/agents/
!.cursor/agents/*.md
!.cursor/rules/
!.cursor/rules/*.mdc
!.cursor/skills/
!.cursor/skills/**
