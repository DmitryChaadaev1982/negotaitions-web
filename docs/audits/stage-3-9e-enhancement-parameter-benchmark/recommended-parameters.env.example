# Stage 3.9E benchmark recommendation (sanitized placeholders only)
# Do not paste secrets here.

# Keep chunked mode
TRANSCRIPT_ENHANCEMENT_MODE="chunked"

# Keep current chunk partition strategy unless code-level split fallback is implemented
TRANSCRIPT_ENHANCEMENT_CHUNK_MAX_SEGMENTS="6"
TRANSCRIPT_ENHANCEMENT_CHUNK_MAX_CHARS="700"

# Concurrency that keeps latency low without observed overload
TRANSCRIPT_ENHANCEMENT_MAX_CONCURRENCY="4"

# Keep bounded timeout/retries
TRANSCRIPT_ENHANCEMENT_CHUNK_TIMEOUT_MS="90000"
TRANSCRIPT_ENHANCEMENT_MAX_RETRIES="1"

# Primary tested token budget baseline
# Note: 2400 works for some chunks but is not globally sufficient for chunk 2 in this sample.
YANDEX_TRANSCRIPT_ENHANCEMENT_MAX_OUTPUT_TOKENS="2400"

# Polling was not proven useful (terminal incomplete observed)
# TRANSCRIPT_ENHANCEMENT_POLL_INTERVAL_MS is intentionally not recommended
# TRANSCRIPT_ENHANCEMENT_POLL_MAX_MS is intentionally not recommended

# Fallback model not configured in production at benchmark time.
# Set only after explicit model verification:
# TRANSCRIPT_ENHANCEMENT_FALLBACK_MODEL="REPLACE_WITH_VERIFIED_SUPPORTED_MODEL"
