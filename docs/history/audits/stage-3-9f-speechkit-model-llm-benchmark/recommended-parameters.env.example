# Stage 3.9F recommendations (design only, do not auto-apply)

# Keep current raw SpeechKit defaults validated in this audit
YANDEX_SPEECHKIT_MODEL=general:rc
YANDEX_SPEECHKIT_LANGUAGE=ru-RU
YANDEX_SPEECHKIT_ENABLE_SPEAKER_LABELING=true
YANDEX_SPEECHKIT_TEXT_NORMALIZATION_ENABLED=true
YANDEX_SPEECHKIT_LITERATURE_TEXT=true

# Keep current enhancement baseline
TRANSCRIPT_ENHANCEMENT_OUTPUT_MODE=json_schema
YANDEX_TRANSCRIPT_ENHANCEMENT_MODEL=deepseek-v4-flash

# New feature-flag proposal for future implementation
# Default false for safe rollout
TRANSCRIPT_ENHANCEMENT_AUTO_RUN=false

# Duplicate-safe update commands (documentation only)
# Linux/server example:
#   grep -q '^TRANSCRIPT_ENHANCEMENT_AUTO_RUN=' .env.production \
#     && sed -i 's/^TRANSCRIPT_ENHANCEMENT_AUTO_RUN=.*/TRANSCRIPT_ENHANCEMENT_AUTO_RUN=false/' .env.production \
#     || echo 'TRANSCRIPT_ENHANCEMENT_AUTO_RUN=false' >> .env.production
#
# Rollback:
#   TRANSCRIPT_ENHANCEMENT_AUTO_RUN=false
# Restart requirement (future implementation phase): yes, app process restart required to apply env changes.

