# NegotAItions local template.
# This file must stay sanitized: placeholders only, no real secrets.
# Copy to .env for local work.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/negotiations"

# App/Auth
APP_URL="http://localhost:3000"
APP_NAME="NegotAItions"
AUTH_SECRET="replace-with-a-random-secret"
ADMIN_EMAILS="admin@example.com"

# Realtime (LiveKit)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="LK_API_KEY_PLACEHOLDER"
LIVEKIT_API_SECRET="LK_API_SECRET_PLACEHOLDER"

# Object storage (Yandex S3-compatible)
S3_BUCKET="your-bucket-name"
S3_REGION="ru-central1"
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"
S3_FORCE_PATH_STYLE="true"

# AI providers
OPENAI_API_KEY="OPENAI_API_KEY_PLACEHOLDER"
YANDEX_FOLDER_ID="YANDEX_FOLDER_ID_PLACEHOLDER"
YANDEX_API_KEY="YANDEX_API_KEY_PLACEHOLDER"
YANDEX_AI_BASE_URL="https://ai.api.cloud.yandex.net/v1"
YANDEX_AI_MODEL="deepseek-v4-flash"

# Optional defaults for transcription flow
OPENAI_TRANSCRIPTION_STRATEGY="diarize_only"
OPENAI_DIARIZATION_MODEL="gpt-4o-transcribe-diarize"
OPENAI_QUALITY_TRANSCRIPTION_MODEL="gpt-4o-transcribe"
AUTO_TRANSCRIBE_AFTER_RECORDING="false"

# Voximplant server-side recording stop (Stage 3.10)
# Modes:
# - disabled
# - prefer_server_with_relay_fallback
# - prefer_server_no_relay_fallback
#
# Browser-relayed signed recording control (RC2):
# - Application env key: VOXIMPLANT_RECORDING_CONTROL_SECRET
# - Scenario primary key: RECORDING_CONTROL_SECRET
# - Scenario compatibility alias: VOXIMPLANT_RECORDING_CONTROL_SECRET
VOXIMPLANT_RECORDING_CONTROL_SECRET="replace-with-recording-control-secret"
VOXIMPLANT_SERVER_STOP_MODE="disabled"
VOXIMPLANT_SERVER_STOP_CONTROL_SECRET="replace-with-server-stop-control-secret"
VOXIMPLANT_SERVER_STOP_CALLBACK_SECRET="replace-with-server-stop-callback-secret"
VOXIMPLANT_SERVER_STOP_CONTROL_TIMEOUT_MS="5000"
VOXIMPLANT_SERVER_STOP_CALLBACK_REPLAY_WINDOW_SECONDS="300"
VOXIMPLANT_SERVER_STOP_TERMINAL_TIMEOUT_SECONDS="90"

# Pause processing mode:
# - source_audio_cut (default production mode if unset)
# - transcript_interval_filter (legacy/deprecated fallback only)
# PAUSE_PROCESSING_MODE="source_audio_cut"

# Optional local debug artifact directory for source_audio_cut artifacts.
# When unset, defaults to ".debug/pause-source-audio".
# PAUSE_SOURCE_AUDIO_DEBUG_DIR=".debug/pause-source-audio"

# Transcript enhancement runtime mode:
# - chunked (default, Stage 3.9E bounded chunk pipeline with partial fallback)
# - single (manual rollback/debug override)
# TRANSCRIPT_ENHANCEMENT_MODE="chunked"
YANDEX_TRANSCRIPT_ENHANCEMENT_ENABLED="false"
TRANSCRIPT_ENHANCEMENT_AUTO_RUN="false"
YANDEX_TRANSCRIPT_ENHANCEMENT_MODEL="deepseek-v4-flash"
TRANSCRIPT_ENHANCEMENT_OUTPUT_MODE="json_schema"
#
# Optional chunk tuning (used only when mode=chunked):
# TRANSCRIPT_ENHANCEMENT_CHUNK_MAX_SEGMENTS="6"
# TRANSCRIPT_ENHANCEMENT_CHUNK_MAX_CHARS="700"
# TRANSCRIPT_ENHANCEMENT_MAX_CONCURRENCY="4"
# TRANSCRIPT_ENHANCEMENT_CHUNK_TIMEOUT_MS="120000"
# TRANSCRIPT_ENHANCEMENT_MAX_RETRIES="1"
# TRANSCRIPT_ENHANCEMENT_FALLBACK_MODEL=""

# Email provider foundation (Stage 3.13B)
# Default remains disabled. Do not add real credentials to this example file.
EMAIL_DELIVERY_ENABLED="false"
EMAIL_PROVIDER="disabled"
EMAIL_CANONICAL_BASE_URL="https://negotaitions.ru"
EMAIL_FROM_NO_REPLY="no-reply@negotaitions.ru"
EMAIL_FROM_NOTIFICATIONS="notifications@negotaitions.ru"
EMAIL_FROM_INVITATIONS="invitations@negotaitions.ru"
EMAIL_REPLY_TO_SUPPORT="support@negotaitions.ru"
EMAIL_REPLY_TO_SECURITY="security@negotaitions.ru"
EMAIL_REPLY_TO_BUSINESS="business@negotaitions.ru"
EMAIL_OPERATOR_NAME="Чаадаев Дмитрий Владимирович"
EMAIL_WORKER_BATCH_SIZE="25"
EMAIL_MAX_ATTEMPTS="5"
EMAIL_RETRY_BASE_SECONDS="60"
EMAIL_RETRY_MAX_SECONDS="43200"
EMAIL_PROCESSING_LEASE_SECONDS="600"
EMAIL_CONTENT_RETENTION_DAYS="90"
EMAIL_DELIVERY_ATTEMPT_RETENTION_DAYS="365"
EMAIL_PROVIDER_ID_RETENTION_DAYS="365"
EMAIL_PROVIDER_EVENT_RETENTION_DAYS="730"
EMAIL_BOUNCE_COMPLAINT_RETENTION_DAYS="730"
EMAIL_ADMIN_TEST_ENABLED="false"
EMAIL_LOCAL_PREVIEW_ENABLED="false"

# Account-security email defaults (Stage 3.13C).
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS="60"
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR="5"

# Trusted reverse-proxy client IP (Stage 3.13C-P).
# Keep false for direct local development. Set true only after nginx overwrites
# X-NegotAItions-Client-IP from $remote_addr on every public application vhost.
TRUSTED_PROXY_ENABLED="false"

# Yandex Cloud Postbox SES-compatible API credentials.
# Required only when EMAIL_DELIVERY_ENABLED=true and EMAIL_PROVIDER=yandex_postbox.
YANDEX_POSTBOX_REGION="ru-central1"
YANDEX_POSTBOX_ENDPOINT="https://postbox.cloud.yandex.net"
YANDEX_POSTBOX_CONFIGURATION_SET=""
YANDEX_POSTBOX_ACCESS_KEY_ID="YANDEX_POSTBOX_ACCESS_KEY_ID_PLACEHOLDER"
YANDEX_POSTBOX_SECRET_ACCESS_KEY="YANDEX_POSTBOX_SECRET_ACCESS_KEY_PLACEHOLDER"
